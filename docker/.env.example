# Docker Compose 环境配置。docker/init.sh 会为 CHANGE_ME_* 生成随机值。
TZ=Asia/Shanghai
DEBUG=false
API_DEBUG=false
DOCKER_CONTAINER=true
API_HOST=0.0.0.0
API_PORT=8000

MONGODB_ENABLED=true
USE_MONGODB_STORAGE=true
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD
MONGODB_DATABASE=tradingagents
MONGODB_AUTH_SOURCE=admin
MONGODB_CONNECTION_STRING=mongodb://${MONGODB_USERNAME}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DATABASE}?authSource=${MONGODB_AUTH_SOURCE}

REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

JWT_SECRET=CHANGE_ME_JWT_SECRET
CSRF_SECRET=CHANGE_ME_CSRF_SECRET
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

TRADINGAGENTS_DATA_DIR=/app/data
QDRANT_DATA_DIR=/app/data/qdrant
SEARXNG_INSTANCES=http://searxng:8080
NO_PROXY=localhost,127.0.0.1,mongodb,redis,searxng

# 登录后在系统设置中添加模型供应商/API Key、默认模型和数据源。
DEFAULT_CHINA_DATA_SOURCE=akshare
